 func IsRunning() bool {
 	return atomic.LoadInt32(&running) == 1
 }
+
+// SetRuntime tunes the Go runtime: GC percent (GOGC), soft memory limit in MiB (GOMEMLIMIT) and GOMAXPROCS.
+// Zero or negative leaves a value unchanged. Environment variables are read before the host app can set them.
+func SetRuntime(gcPercent int, memoryLimitMB int, maxProcs int) {
+	if gcPercent > 0 {
+		debug.SetGCPercent(gcPercent)
+	}
+	if memoryLimitMB > 0 {
+		debug.SetMemoryLimit(int64(memoryLimitMB) << 20)
+	}
+	if maxProcs > 0 {
+		runtime.GOMAXPROCS(maxProcs)
+	}
+}
+
+// FreeMemory runs a GC and returns freed memory to the OS — before the host app is suspended.
+func FreeMemory() {
+	runtime.GC()
+	debug.FreeOSMemory()
+}
