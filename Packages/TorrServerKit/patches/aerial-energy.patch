+
+var lastThrottledFree atomic.Int64
+
+// FreeOSMemGCThrottled is FreeOSMemGC at most once per 30 s. Aerial (iOS): cache eviction called a full GC with
+// memory release on every evicted piece — several times a second while streaming, a major battery cost.
+func FreeOSMemGCThrottled() {
+	now := time.Now().UnixNano()
+	last := lastThrottledFree.Load()
+	if now-last < int64(30*time.Second) || !lastThrottledFree.CompareAndSwap(last, now) {
+		return
+	}
+	FreeOSMemGC()
+}
